# studionet (default) | testnet-asimov
GENLAYER_NETWORK=studionet

# On studionet, empty keys mean a fresh wallet per role for every run, and each wallet is funded
# from the StudioNet faucet (every write pays a fee). On a funded network all are required.
# Never commit real keys.
DEPLOYER_PRIVATE_KEY=
PRO_PRIVATE_KEY=
CON_PRIVATE_KEY=
STRANGER_PRIVATE_KEY=
